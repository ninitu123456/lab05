# Lab 5 — frontend runtime keys (copy to .env, never commit .env)
# Client-side public keys MUST use the VITE_ prefix

# Leave EMPTY in dev → same-origin /api via Vite proxy (no CORS)
VITE_API_BASE_URL=

# Dev-server only (NOT exposed to the browser): where Vite proxies /api
API_PROXY_TARGET=http://localhost:5000